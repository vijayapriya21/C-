#include <iostream>
using namespace std;

int main()
{
    int a, b, c, d, e, f, g;

    cout << "ARITHMETIC OPERATIONS" << endl;
    cout << "----------------------" << endl;

    cout << "Enter the first number: ";
    cin >> a;

    cout << "Enter the second number: ";
    cin >> b;

    c = a + b;
    cout << "Addition: " << c << endl;

    d = a - b;
    cout << "Subtraction: " << d << endl;

    e = a * b;
    cout << "Multiplication: " << e << endl;

    f = a / b;
    cout << "Division: " << f << endl;

    g = a % b;
    cout << "Modulus: " << g << endl;

    return 0;
}
